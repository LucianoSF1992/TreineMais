@model TreineMais.ViewModels.Dashboard.AdminDashboardViewModel

<div class="container py-4">

    <!-- Header -->
    <div
        class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="mb-1">Dashboard - Admin</h2>
            <div class="text-muted">Visão geral do sistema</div>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Admin">
                <i class="bi bi-arrow-clockwise me-1"></i> Atualizar
            </a>
        </div>
    </div>

    <!-- Cards -->
    <div class="row g-3">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="text-muted small">Usuários</div>
                    <div class="display-6 fw-bold">@Model.TotalUsuarios</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="text-muted small">Alunos</div>
                    <div class="display-6 fw-bold">@Model.TotalAlunos</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="text-muted small">Instrutores</div>
                    <div class="display-6 fw-bold">@Model.TotalInstrutores</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="text-muted small">Treinos</div>
                    <div class="display-6 fw-bold">@Model.TotalTreinos</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section divider -->
    <hr class="my-4" />

    <!-- Ações rápidas -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div
                class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-2 mb-3">
                <h5 class="mb-0">Ações rápidas</h5>
                <span class="text-muted small">Atalhos para tarefas frequentes</span>
            </div>

            <div class="row g-2">
                <div class="col-12 col-md-6 col-lg-3">
                    <a class="btn btn-primary w-100" asp-controller="Admin" asp-action="Alunos">
                        Gerenciar Alunos
                    </a>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <a class="btn btn-outline-primary w-100" asp-controller="Admin" asp-action="CriarAluno">
                        Criar Aluno
                    </a>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <a class="btn btn-outline-primary w-100" asp-controller="Admin" asp-action="Treinos">
                        Treinos
                    </a>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <a class="btn btn-outline-primary w-100" asp-controller="Admin" asp-action="CriarTreino">
                        Criar Treino
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>