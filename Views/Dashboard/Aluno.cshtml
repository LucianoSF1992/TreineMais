@model TreineMais.ViewModels.Dashboard.AlunoDashboardViewModel

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="mb-0">Dashboard - Aluno</h2>
        <small class="text-muted">Seus treinos atribuídos</small>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted">Total de treinos</div>
                <div class="display-6 fw-bold">@Model.TotalTreinos</div>
            </div>
        </div>
    </div>
</div>

<h5 class="mb-2">Meus treinos</h5>

@if (!Model.MeusTreinos.Any())
{
    <div class="alert alert-info">Você ainda não possui treinos atribuídos.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Treino</th>
                    <th>Dia</th>
                    <th>Instrutor</th>
                    <th>Status</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.MeusTreinos)
                {
                    <tr>
                        <td class="fw-semibold">@t.Nome</td>
                        <td>@t.DiaSemana</td>
                        <td>@(t.Instrutor?.NomeCompleto ?? t.Instrutor?.Email ?? "—")</td>
                        <td>
                            @if (t.Concluido)
                            {
                                <span class="badge bg-success">Concluído</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pendente</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (!t.Concluido)
                            {
                                <form asp-controller="Treinos" asp-action="Concluir" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="btn btn-sm btn-success">
                                        Marcar concluído
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-controller="Treinos" asp-action="Reabrir" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        Reabrir
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}