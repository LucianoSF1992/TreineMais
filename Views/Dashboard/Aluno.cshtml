@model TreineMais.ViewModels.Dashboard.AlunoDashboardViewModel
@{
    ViewData["Title"] = "Dashboard - Aluno";
}

<div class="container mt-5">

    <!-- Header da página -->
    <div class="mb-4">
        <h1 class="display-6 fw-bold mb-1">Dashboard - Aluno</h1>
        <p class="text-muted mb-0">Seus treinos atribuídos</p>
    </div>

    <!-- Cards de métricas -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Total de treinos</div>
                    <div class="fs-1 fw-bold">@Model.TotalTreinos</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Concluídos</div>
                    <div class="fs-1 fw-bold">@Model.Concluidos</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="text-muted small">Pendentes</div>
                    <div class="fs-1 fw-bold">@Model.Pendentes</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Lista de treinos -->
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h4 class="mb-0">Meus treinos</h4>
    </div>

    @if (Model.MeusTreinos == null || !Model.MeusTreinos.Any())
    {
        <div class="alert alert-info border-0 shadow-sm">
            <div class="d-flex align-items-start gap-2">
                <div>
                    <strong>Você ainda não possui treinos atribuídos.</strong>
                    <div class="text-muted">
                        Quando o instrutor criar treinos para você, eles aparecerão aqui.
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Treino</th>
                            <th>Dia</th>
                            <th>Instrutor</th>
                            <th>Status</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.MeusTreinos)
                        {
                            <tr>
                                <td class="fw-semibold">@t.Nome</td>
                                <td>@(string.IsNullOrWhiteSpace(t.DiaSemana) ? "—" : t.DiaSemana)</td>
                                <td>@(t.Instrutor?.NomeCompleto ?? t.Instrutor?.Email ?? "—")</td>
                                <td>
                                    @if (t.Concluido)
                                    {
                                        <span class="badge text-bg-success">Concluído</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-warning">Pendente</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (!t.Concluido)
                                    {
                                        <form asp-controller="Treinos" asp-action="Concluir" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@t.Id" />
                                            <button class="btn btn-sm btn-success">Concluir</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Treinos" asp-action="Reabrir" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@t.Id" />
                                            <button class="btn btn-sm btn-outline-secondary">Reabrir</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>