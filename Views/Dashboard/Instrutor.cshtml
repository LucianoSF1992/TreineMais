@model TreineMais.ViewModels.Dashboard.InstrutorDashboardViewModel
@using System.Text.Json

<div class="container py-4">

    <!-- Header -->
    <div
        class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="mb-1">Dashboard - Instrutor</h2>
            <div class="text-muted">Resumo dos seus alunos e treinos</div>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-controller="Admin" asp-action="CriarTreino">
                Criar Treino
            </a>
        </div>
    </div>

    <!-- Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Meus treinos</div>
                    <div class="display-6 fw-bold">@Model.TotalTreinos</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Meus alunos</div>
                    <div class="display-6 fw-bold">@Model.TotalAlunos</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 🔥 GRÁFICOS -->
    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="mb-3">Status dos treinos</h5>

                    @if (Model.TotalTreinos == 0)
                    {
                        <div class="alert alert-info mb-0">Sem dados para exibir ainda.</div>
                    }
                    else
                    {
                        <div style="min-height:220px;">
                            <canvas id="chartStatus"></canvas>
                        </div>
                        <div class="small text-muted mt-2">
                            Concluídos: <strong>@Model.Concluidos</strong> •
                            Pendentes: <strong>@Model.Pendentes</strong>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="mb-3">Treinos por dia da semana</h5>

                    @if (Model.TreinosPorDiaSemana == null || !Model.TreinosPorDiaSemana.Any())
                    {
                        <div class="alert alert-info mb-0">Sem dados para exibir ainda.</div>
                    }
                    else
                    {
                        <div style="min-height:260px;">
                            <canvas id="chartDias"></canvas>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Conteúdo principal -->
    <div class="row g-4">

        <!-- Alunos -->
        <div class="col-12 col-xl-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="mb-3">Meus alunos</h5>

                    @if (!Model.MeusAlunos.Any())
                    {
                        <div class="alert alert-info mb-0">
                            Você ainda não possui alunos com treinos cadastrados.
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var a in Model.MeusAlunos)
                            {
                                <div class="list-group-item px-0">
                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">

                                        <div>
                                            <div class="fw-semibold">@a.Nome</div>
                                            <small class="text-muted">@a.Email</small>
                                        </div>

                                        <div class="text-md-end w-100 w-md-auto">
                                            <div class="mb-1">
                                                <span class="badge bg-primary">Treinos: @a.TreinosDoAluno</span>
                                                <span class="badge bg-success">OK: @a.Concluidos</span>
                                                <span class="badge bg-warning text-dark">Pend: @a.Pendentes</span>
                                            </div>

                                            <a class="btn btn-sm btn-outline-primary" asp-controller="Treinos"
                                                   asp-action="DoAluno" asp-route-alunoId="@a.AlunoId">
                                                Ver ficha
                                            </a>
                                        </div>

                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Últimos treinos -->
        <div class="col-12 col-xl-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="mb-3">Últimos treinos</h5>

                    @if (!Model.UltimosTreinos.Any())
                    {
                        <div class="alert alert-info mb-0">
                            Você ainda não cadastrou treinos.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Treino</th>
                                        <th class="d-none d-md-table-cell">Dia</th>
                                        <th>Aluno</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in Model.UltimosTreinos)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@t.Nome</td>
                                            <td class="d-none d-md-table-cell">@t.DiaSemana</td>
                                            <td>@t.AlunoNome</td>
                                            <td>
                                                @if (t.Concluido)
                                                {
                                                    <span class="badge bg-success">Concluído</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">Pendente</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="mt-3 d-flex flex-column flex-sm-row gap-2">
                        <a class="btn btn-outline-primary" asp-controller="Admin" asp-action="Treinos">
                            Ver todos
                        </a>

                        <a class="btn btn-primary" asp-controller="Admin" asp-action="CriarTreino">
                            Criar treino
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        (function () {

        // Doughnut
        const concluidos = @Model.Concluidos;
        const pendentes = @Model.Pendentes;

        const statusEl = document.getElementById('chartStatus');
        if (statusEl) {
        new Chart(statusEl, {
        type: 'doughnut',
        data: {
        labels: ['Concluídos', 'Pendentes'],
        datasets: [{
        data: [concluidos, pendentes]
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { position: 'bottom' } }
        }
        });
        }

        // Bar
        const dataDict = @Html.Raw(JsonSerializer.Serialize(Model.TreinosPorDiaSemana));
        const ordem = ['Segunda', 'Terça', 'Quarta', 'Quinta', 'Sexta', 'Sábado', 'Domingo'];

        const labels = ordem.filter(d => dataDict[d] !== undefined);
        for (const k in dataDict) {
        if (!labels.includes(k)) labels.push(k);
        }

        const values = labels.map(l => dataDict[l] ?? 0);

        const diasEl = document.getElementById('chartDias');
        if (diasEl) {
        new Chart(diasEl, {
        type: 'bar',
        data: {
        labels: labels,
        datasets: [{ label: 'Treinos', data: values }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
        }
        });
        }

        })();
    </script>
}