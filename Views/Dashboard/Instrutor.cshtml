@model TreineMais.ViewModels.Dashboard.InstrutorDashboardViewModel

<div class="container py-4">

    <!-- Header -->
    <div
        class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="mb-1">Dashboard - Instrutor</h2>
            <div class="text-muted">Resumo dos seus alunos e treinos</div>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-controller="Admin" asp-action="CriarTreino">
                Criar Treino
            </a>
        </div>
    </div>

    <!-- Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Meus treinos</div>
                    <div class="display-6 fw-bold">@Model.TotalTreinos</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Meus alunos</div>
                    <div class="display-6 fw-bold">@Model.TotalAlunos</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Conteúdo principal -->
    <div class="row g-4">

        <!-- Alunos -->
        <div class="col-12 col-xl-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="mb-3">Meus alunos</h5>

                    @if (!Model.MeusAlunos.Any())
                    {
                        <div class="alert alert-info mb-0">
                            Você ainda não possui alunos com treinos cadastrados.
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var a in Model.MeusAlunos)
                            {
                                <div class="list-group-item px-0">
                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">

                                        <!-- Info -->
                                        <div>
                                            <div class="fw-semibold">@a.Nome</div>
                                            <small class="text-muted">@a.Email</small>
                                        </div>

                                        <!-- Stats + botão -->
                                        <div class="text-md-end w-100 w-md-auto">
                                            <div class="mb-1">
                                                <span class="badge bg-primary">Treinos: @a.TreinosDoAluno</span>
                                                <span class="badge bg-success">OK: @a.Concluidos</span>
                                                <span class="badge bg-warning text-dark">Pend: @a.Pendentes</span>
                                            </div>

                                            <a class="btn btn-sm btn-outline-primary"                       asp-controller="Treinos"
                                                   asp-action="DoAluno"                                      asp-route-alunoId="@a.AlunoId">
                                                Ver ficha
                                            </a>
                                        </div>

                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Últimos treinos -->
        <div class="col-12 col-xl-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="mb-3">Últimos treinos</h5>

                    @if (!Model.UltimosTreinos.Any())
                    {
                        <div class="alert alert-info mb-0">
                            Você ainda não cadastrou treinos.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Treino</th>
                                        <th class="d-none d-md-table-cell">Dia</th>
                                        <th>Aluno</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in Model.UltimosTreinos)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@t.Nome</td>
                                            <td class="d-none d-md-table-cell">@t.DiaSemana</td>
                                            <td>@t.AlunoNome</td>
                                            <td>
                                                @if (t.Concluido)
                                                {
                                                    <span class="badge bg-success">Concluído</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">Pendente</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="mt-3 d-flex flex-column flex-sm-row gap-2">
                        <a class="btn btn-outline-primary"                  asp-controller="Admin"                          asp-action="Treinos">
                            Ver todos
                        </a>

                        <a class="btn btn-primary"             asp-controller="Admin" asp-action="CriarTreino">
                            Criar treino
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>