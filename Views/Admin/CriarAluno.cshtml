@model TreineMais.Models.ApplicationUser

@{
    ViewData["Title"] = "Criar Aluno";
}

<div class="container mt-4">

    <div
        class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-2 mb-3">
        <div>
            <h2 class="mb-1">Criar Aluno</h2>
            <div class="text-muted">Cadastre um novo aluno para receber treinos</div>
        </div>

        <a asp-action="Alunos" class="btn btn-outline-secondary">
            ← Voltar
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form asp-action="CriarAluno" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-12 col-md-6">
                        <label asp-for="NomeCompleto" class="form-label">Nome</label>
                        <input asp-for="NomeCompleto" class="form-control" placeholder="Ex: João da Silva" />
                        <span asp-validation-for="NomeCompleto" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" placeholder="Ex: joao@email.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-3">
                        <label asp-for="Idade" class="form-label">Idade</label>
                        <input asp-for="Idade" class="form-control" type="number" min="1" max="120"
                               placeholder="Ex: 25" />
                        <span asp-validation-for="Idade" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-9">
                        <label asp-for="Objetivo" class="form-label">Objetivo</label>
                        <input asp-for="Objetivo" class="form-control"
                               placeholder="Ex: Hipertrofia / Emagrecimento / Condicionamento" />
                        <span asp-validation-for="Objetivo" class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Senha</label>
                        <input name="senha" type="password" class="form-control" placeholder="Crie uma senha segura" />
                        <span class="text-danger">
                            @Html.ValidationMessage("senha")
                        </span>
                    </div>

                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        Salvar
                    </button>

                    <a asp-action="Alunos" class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}