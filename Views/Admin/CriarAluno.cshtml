@model TreineMais.Models.ApplicationUser

<div class="container mt-4">
    <a asp-controller="Admin" asp-action="Alunos" class="btn btn-outline-secondary mb-3">
        ← Voltar
    </a>
    <h2>Novo Aluno</h2>

    <form asp-action="CriarAluno" method="post">
        <div class="mb-3">
            <label>Nome Completo</label>
            <input asp-for="NomeCompleto" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Email</label>
            <input asp-for="Email" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Idade</label>
            <input asp-for="Idade" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Objetivo</label>
            <input asp-for="Objetivo" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Senha</label>
            <input type="password" name="senha" class="form-control" />
        </div>

        <button class="btn btn-primary">Salvar</button>
    </form>
</div>