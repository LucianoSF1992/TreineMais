@model List<TreineMais.Models.Treino>

@{
    ViewData["Title"] = "Treinos";
    var alunos = ViewBag.Alunos as List<TreineMais.Models.ApplicationUser>;
}

<div class="container mt-4">
    <h2>Cadastro de Treinos</h2>

    <a class="btn btn-success mb-3" asp-action="CriarTreino">
        + Adicionar Exercício
    </a>

    <div class="row">
        @foreach (var treino in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5>@treino.NomeExercicio</h5>
                        <p><strong>Aluno:</strong> @treino.Aluno?.NomeCompleto</p>
                        <p>@treino.Series x @treino.Repeticoes</p>
                        <p>Descanso: @treino.Descanso s ⏱️</p>
                        <p><strong>Dia:</strong> @treino.DiaSemana</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>