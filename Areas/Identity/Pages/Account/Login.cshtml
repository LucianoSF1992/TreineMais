<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Treine+ | Login</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

  <style>
    :root{
      --brand: #22c55e;
      --brand-2:#16a34a;
      --bg1:#0b1220;
      --bg2:#0f1a33;
    }

    body{
      min-height: 100vh;
      background:
        radial-gradient(1200px 600px at 10% 10%, rgba(34,197,94,.18), transparent 60%),
        radial-gradient(900px 500px at 90% 30%, rgba(59,130,246,.16), transparent 55%),
        linear-gradient(135deg, var(--bg1), var(--bg2));
      color: #e5e7eb;
    }

    .auth-shell{
      min-height: 100vh;
      display:flex;
      align-items:center;
      padding: 24px 0;
    }

    .auth-card{
      background: rgba(255,255,255,.06);
      border: 1px solid rgba(255,255,255,.10);
      border-radius: 20px;
      overflow:hidden;
      box-shadow: 0 20px 60px rgba(0,0,0,.35);
      backdrop-filter: blur(10px);
    }

    .brand-badge{
      display:inline-flex;
      align-items:center;
      gap:.6rem;
      padding:.55rem .9rem;
      border-radius: 999px;
      background: rgba(34,197,94,.14);
      border: 1px solid rgba(34,197,94,.22);
      color: #dcfce7;
      font-weight:600;
      letter-spacing:.2px;
    }

    .auth-hero{
      padding: 28px;
      height:100%;
      background:
        linear-gradient(180deg, rgba(34,197,94,.22), rgba(34,197,94,.06));
      border-right: 1px solid rgba(255,255,255,.08);
    }

    .auth-hero h2{
      font-weight:800;
      line-height:1.1;
      margin-top: 18px;
    }

    .auth-hero p{ color: rgba(229,231,235,.85); }

    .auth-form{
      padding: 28px;
    }

    .form-control, .form-select{
      background: rgba(255,255,255,.08) !important;
      border: 1px solid rgba(255,255,255,.12) !important;
      color:#e5e7eb !important;
      border-radius: 12px;
    }
    .form-control::placeholder{ color: rgba(229,231,235,.55); }
    .form-control:focus{
      box-shadow: 0 0 0 .25rem rgba(34,197,94,.20) !important;
      border-color: rgba(34,197,94,.55) !important;
    }

    .input-group-text{
      background: rgba(255,255,255,.08);
      border: 1px solid rgba(255,255,255,.12);
      color: rgba(229,231,235,.85);
      border-radius: 12px;
    }

    .btn-brand{
      background: linear-gradient(135deg, var(--brand), var(--brand-2));
      border:0;
      border-radius: 12px;
      font-weight:700;
      padding: .8rem 1rem;
      box-shadow: 0 14px 30px rgba(34,197,94,.18);
    }
    .btn-brand:hover{ filter: brightness(1.03); }

    .link-soft{
      color: rgba(229,231,235,.85);
      text-decoration: none;
    }
    .link-soft:hover{ color: white; text-decoration: underline; }

    .small-muted{ color: rgba(229,231,235,.7); }

    .divider{
      display:flex;
      align-items:center;
      gap:12px;
      color: rgba(229,231,235,.6);
      font-size:.9rem;
      margin: 16px 0;
    }
    .divider::before, .divider::after{
      content:"";
      height:1px;
      flex:1;
      background: rgba(255,255,255,.12);
    }

    @media (max-width: 767.98px){
      .auth-hero{ display:none; }
      .auth-form{ padding: 22px; }
    }
  </style>
</head>
<body>
  <div class="auth-shell">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-9">
          <div class="auth-card">
            <div class="row g-0">
              <!-- Hero (desktop) -->
              <div class="col-md-5 d-none d-md-block">
                <div class="auth-hero">
                  <span class="brand-badge">
                    <i class="bi bi-lightning-charge-fill"></i> Treine+
                  </span>
                  <h2 class="mt-3">Entre e continue seu progresso.</h2>
                  <p class="mt-3">
                    Treinos organizados, evolução registrada e rotina mais simples.
                  </p>

                  <div class="mt-4 small-muted">
                    <div class="d-flex align-items-center gap-2 mb-2">
                      <i class="bi bi-check2-circle"></i> Rotina de treinos
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                      <i class="bi bi-check2-circle"></i> Histórico e métricas
                    </div>
                    <div class="d-flex align-items-center gap-2">
                      <i class="bi bi-check2-circle"></i> Acesso rápido no celular
                    </div>
                  </div>
                </div>
              </div>

              <!-- Form -->
              <div class="col-12 col-md-7">
                <div class="auth-form">
                  <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                      <div class="brand-badge d-md-none">
                        <i class="bi bi-lightning-charge-fill"></i> Treine+
                      </div>
                      <h3 class="mt-3 mb-1 fw-bold">Login</h3>
                      <div class="small-muted">Acesse sua conta para continuar.</div>
                    </div>
                  </div>

                  <form class="needs-validation" novalidate action="" method="post">
                    <div class="mb-3">
                      <label class="form-label">E-mail</label>
                      <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input type="email" class="form-control" placeholder="voce@exemplo.com" required>
                        <div class="invalid-feedback">Informe um e-mail válido.</div>
                      </div>
                    </div>

                    <div class="mb-2">
                      <label class="form-label">Senha</label>
                      <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input id="loginPassword" type="password" class="form-control" placeholder="Sua senha" minlength="6" required>
                        <button class="btn btn-outline-light" type="button" id="toggleLoginPassword" style="border-radius:12px;">
                          <i class="bi bi-eye"></i>
                        </button>
                        <div class="invalid-feedback">Informe sua senha (mín. 6 caracteres).</div>
                      </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 mt-2">
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="rememberMe">
                        <label class="form-check-label small-muted" for="rememberMe">Lembrar de mim</label>
                      </div>
                      <a class="link-soft small" href="/forgot-password">Esqueci a senha</a>
                    </div>

                    <button class="btn btn-brand w-100" type="submit">
                      Entrar <i class="bi bi-arrow-right ms-1"></i>
                    </button>

                    <div class="divider">ou</div>

                    <div class="text-center small-muted">
                      Não tem conta?
                      <a class="link-soft fw-semibold" href="/register">Criar agora</a>
                    </div>
                  </form>

                </div>
              </div>
            </div><!-- row -->
          </div><!-- card -->
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Bootstrap validation
    (() => {
      'use strict'
      const forms = document.querySelectorAll('.needs-validation')
      Array.from(forms).forEach(form => {
        form.addEventListener('submit', event => {
          if (!form.checkValidity()) {
            event.preventDefault()
            event.stopPropagation()
          }
          form.classList.add('was-validated')
        }, false)
      })
    })()

    // Show/hide password
    const pwd = document.getElementById('loginPassword');
    const btn = document.getElementById('toggleLoginPassword');
    btn.addEventListener('click', () => {
      const isPass = pwd.type === 'password';
      pwd.type = isPass ? 'text' : 'password';
      btn.innerHTML = isPass ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
    });
  </script>
</body>
</html>