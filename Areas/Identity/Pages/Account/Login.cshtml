@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-page">
    <div class="auth-shell">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-lg-10 col-xl-9">
                    <div class="auth-card">
                        <div class="row g-0">
                            <!-- Hero (desktop) -->
                            <div class="col-md-5 d-none d-md-block">
                                <div class="auth-hero">
                                    <span class="brand-badge">
                                        <i class="bi bi-lightning-charge-fill"></i> Treine+
                                    </span>

                                    <h2 class="mt-3">Entre e continue seu progresso.</h2>
                                    <p class="mt-3">
                                        Treinos organizados, evolução registrada e rotina mais simples.
                                    </p>

                                    <div class="mt-4 small-muted">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <i class="bi bi-check2-circle"></i> Rotina de treinos
                                        </div>
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <i class="bi bi-check2-circle"></i> Histórico e métricas
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-check2-circle"></i> Acesso rápido no celular
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Form -->
                            <div class="col-12 col-md-7">
                                <div class="auth-form">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div>
                                            <div class="brand-badge d-md-none">
                                                <i class="bi bi-lightning-charge-fill"></i> Treine+
                                            </div>
                                            <h3 class="mt-3 mb-1 fw-bold">Login</h3>
                                            <div class="small-muted">Acesse sua conta para continuar.</div>
                                        </div>
                                    </div>

                                    <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl" class="needs-validation" novalidate>
                                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                                        <div class="mb-3">
                                            <label asp-for="Input.Email" class="form-label">E-mail</label>
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                                <input asp-for="Input.Email" class="form-control" placeholder="voce@exemplo.com" autocomplete="username" required />
                                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                                                <div class="invalid-feedback">Informe um e-mail válido.</div>
                                            </div>
                                        </div>

                                        <div class="mb-2">
                                            <label asp-for="Input.Password" class="form-label">Senha</label>
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                                <input asp-for="Input.Password" id="loginPassword" class="form-control" placeholder="Sua senha" autocomplete="current-password" required />
                                                <button class="btn btn-outline-secondary" type="button" id="toggleLoginPassword" style="border-radius:12px;">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                                                <div class="invalid-feedback">Informe sua senha.</div>
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center mb-3 mt-2">
                                            <div class="form-check">
                                                <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMe" />
                                                <label class="form-check-label small-muted" asp-for="Input.RememberMe">Lembrar de mim</label>
                                            </div>
                                            <a class="link-soft small" asp-page="./ForgotPassword">Esqueci a senha</a>
                                        </div>

                                        <button id="login-submit" type="submit" class="btn btn-brand w-100">
                                            Entrar <i class="bi bi-arrow-right ms-1"></i>
                                        </button>

                                        <div class="divider">ou</div>

                                        <div class="text-center small-muted">
                                            Não tem conta?
                                            <a class="link-soft fw-semibold" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Criar agora</a>
                                        </div>
                                    </form>

                                </div>
                            </div>
                        </div><!-- row -->
                    </div><!-- card -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Bootstrap validation
        (() => {
            'use strict'
            const forms = document.querySelectorAll('.needs-validation')
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()

        // Show/hide password
        const pwd = document.getElementById('loginPassword');
        const btn = document.getElementById('toggleLoginPassword');

        if (pwd && btn) {
            btn.addEventListener('click', () => {
                const isPass = pwd.type === 'password';
                pwd.type = isPass ? 'text' : 'password';
                btn.innerHTML = isPass ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
            });
        }
    </script>
}