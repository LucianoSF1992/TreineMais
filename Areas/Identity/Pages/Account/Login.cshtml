<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Treine+ | Login</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

</head>
<body>
  <div class="auth-shell">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-9">
          <div class="auth-card">
            <div class="row g-0">
              <!-- Hero (desktop) -->
              <div class="col-md-5 d-none d-md-block">
                <div class="auth-hero">
                  <span class="brand-badge">
                    <i class="bi bi-lightning-charge-fill"></i> Treine+
                  </span>
                  <h2 class="mt-3">Entre e continue seu progresso.</h2>
                  <p class="mt-3">
                    Treinos organizados, evolução registrada e rotina mais simples.
                  </p>

                  <div class="mt-4 small-muted">
                    <div class="d-flex align-items-center gap-2 mb-2">
                      <i class="bi bi-check2-circle"></i> Rotina de treinos
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                      <i class="bi bi-check2-circle"></i> Histórico e métricas
                    </div>
                    <div class="d-flex align-items-center gap-2">
                      <i class="bi bi-check2-circle"></i> Acesso rápido no celular
                    </div>
                  </div>
                </div>
              </div>

              <!-- Form -->
              <div class="col-12 col-md-7">
                <div class="auth-form">
                  <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                      <div class="brand-badge d-md-none">
                        <i class="bi bi-lightning-charge-fill"></i> Treine+
                      </div>
                      <h3 class="mt-3 mb-1 fw-bold">Login</h3>
                      <div class="small-muted">Acesse sua conta para continuar.</div>
                    </div>
                  </div>

                  <form class="needs-validation" novalidate action="" method="post">
                    <div class="mb-3">
                      <label class="form-label">E-mail</label>
                      <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input type="email" class="form-control" placeholder="voce@exemplo.com" required>
                        <div class="invalid-feedback">Informe um e-mail válido.</div>
                      </div>
                    </div>

                    <div class="mb-2">
                      <label class="form-label">Senha</label>
                      <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input id="loginPassword" type="password" class="form-control" placeholder="Sua senha" minlength="6" required>
                        <button class="btn btn-outline-light" type="button" id="toggleLoginPassword" style="border-radius:12px;">
                          <i class="bi bi-eye"></i>
                        </button>
                        <div class="invalid-feedback">Informe sua senha (mín. 6 caracteres).</div>
                      </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 mt-2">
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="rememberMe">
                        <label class="form-check-label small-muted" for="rememberMe">Lembrar de mim</label>
                      </div>
                      <a class="link-soft small" href="/forgot-password">Esqueci a senha</a>
                    </div>

                    <button class="btn btn-brand w-100" type="submit">
                      Entrar <i class="bi bi-arrow-right ms-1"></i>
                    </button>

                    <div class="divider">ou</div>

                    <div class="text-center small-muted">
                      Não tem conta?
                      <a class="link-soft fw-semibold" href="/register">Criar agora</a>
                    </div>
                  </form>

                </div>
              </div>
            </div><!-- row -->
          </div><!-- card -->
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Bootstrap validation
    (() => {
      'use strict'
      const forms = document.querySelectorAll('.needs-validation')
      Array.from(forms).forEach(form => {
        form.addEventListener('submit', event => {
          if (!form.checkValidity()) {
            event.preventDefault()
            event.stopPropagation()
          }
          form.classList.add('was-validated')
        }, false)
      })
    })()

    // Show/hide password
    const pwd = document.getElementById('loginPassword');
    const btn = document.getElementById('toggleLoginPassword');
    btn.addEventListener('click', () => {
      const isPass = pwd.type === 'password';
      pwd.type = isPass ? 'text' : 'password';
      btn.innerHTML = isPass ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
    });
  </script>
</body>
</html>