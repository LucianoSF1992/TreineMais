<!doctype html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Treine+ | Criar conta</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

</head>

<body>
    <div class="auth-shell">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-lg-10 col-xl-9">
                    <div class="auth-card">
                        <div class="row g-0">
                            <!-- Hero (desktop) -->
                            <div class="col-md-5 d-none d-md-block">
                                <div class="auth-hero">
                                    <span class="brand-badge">
                                        <i class="bi bi-lightning-charge-fill"></i> Treine+
                                    </span>
                                    <h2 class="mt-3">Crie sua conta em minutos.</h2>
                                    <p class="mt-3">
                                        Comece a registrar treinos e acompanhar evolução com praticidade.
                                    </p>

                                    <div class="mt-4 small-muted">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <i class="bi bi-shield-check"></i> Seus dados protegidos
                                        </div>
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <i class="bi bi-phone"></i> Perfeito no celular
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-graph-up"></i> Evolução visível
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Form -->
                            <div class="col-12 col-md-7">
                                <div class="auth-form">
                                    <div class="brand-badge d-md-none">
                                        <i class="bi bi-lightning-charge-fill"></i> Treine+
                                    </div>

                                    <h3 class="mt-3 mb-1 fw-bold">Criar conta</h3>
                                    <div class="small-muted mb-3">Preencha os dados para se cadastrar.</div>

                                    <form class="needs-validation" novalidate action="" method="post" id="registerForm">
                                        <div class="mb-3">
                                            <label class="form-label">Nome</label>
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                                <input type="text" class="form-control" placeholder="Seu nome" required>
                                                <div class="invalid-feedback">Informe seu nome.</div>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">E-mail</label>
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                                <input type="email" class="form-control" placeholder="voce@exemplo.com"
                                                       required>
                                                <div class="invalid-feedback">Informe um e-mail válido.</div>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">Senha</label>
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                                <input id="regPassword" type="password" class="form-control"
                                                       placeholder="Mín. 6 caracteres" minlength="6" required>
                                                <button class="btn btn-outline-light" type="button"
                                                        id="toggleRegPassword" style="border-radius:12px;">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                <div class="invalid-feedback">Senha com mínimo de 6 caracteres.</div>
                                            </div>
                                        </div>

                                        <div class="mb-2">
                                            <label class="form-label">Confirmar senha</label>
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                                <input id="regConfirm" type="password" class="form-control"
                                                       placeholder="Repita a senha" minlength="6" required>
                                                <button class="btn btn-outline-light" type="button"
                                                        id="toggleRegConfirm" style="border-radius:12px;">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                <div class="invalid-feedback">Confirme sua senha.</div>
                                            </div>
                                            <div id="matchHelp" class="small mt-2 small-muted"></div>
                                        </div>

                                        <button class="btn btn-brand w-100 mt-3" type="submit">
                                            Criar conta <i class="bi bi-arrow-right ms-1"></i>
                                        </button>

                                        <div class="text-center mt-3 small-muted">
                                            Já tem conta?
                                            <a class="link-soft fw-semibold" href="/login">Entrar</a>
                                        </div>
                                    </form>

                                </div>
                            </div>
                        </div><!-- row -->
                    </div><!-- card -->
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Bootstrap validation
        (() => {
        'use strict'
        const forms = document.querySelectorAll('.needs-validation')
        Array.from(forms).forEach(form => {
        form.addEventListener('submit', event => {
        // valida match de senha
        const p = document.getElementById('regPassword');
        const c = document.getElementById('regConfirm');
        if (p && c && p.value !== c.value) {
        c.setCustomValidity('Senha não confere');
        } else if (c) {
        c.setCustomValidity('');
        }

        if (!form.checkValidity()) {
        event.preventDefault()
        event.stopPropagation()
        }
        form.classList.add('was-validated')
        }, false)
        })
        })()

        // Show/hide password
        const regPwd = document.getElementById('regPassword');
        const regConf = document.getElementById('regConfirm');
        const btnPwd = document.getElementById('toggleRegPassword');
        const btnConf = document.getElementById('toggleRegConfirm');
        const matchHelp = document.getElementById('matchHelp');

        btnPwd.addEventListener('click', () => {
        const isPass = regPwd.type === 'password';
        regPwd.type = isPass ? 'text' : 'password';
        btnPwd.innerHTML = isPass ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
        });

        btnConf.addEventListener('click', () => {
        const isPass = regConf.type === 'password';
        regConf.type = isPass ? 'text' : 'password';
        btnConf.innerHTML = isPass ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
        });

        function checkMatch() {
        if (!regPwd.value && !regConf.value) { matchHelp.textContent = ''; return; }
        if (regPwd.value === regConf.value) {
        matchHelp.textContent = '✅ As senhas conferem.';
        } else {
        matchHelp.textContent = '⚠️ As senhas não conferem.';
        }
        }
        regPwd.addEventListener('input', checkMatch);
        regConf.addEventListener('input', checkMatch);
    </script>
</body>

</html>