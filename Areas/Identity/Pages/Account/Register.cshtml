@page
@model RegisterModel
@{
    ViewData["Title"] = "Criar conta";
}

<div class="auth-page">
    <div class="auth-shell">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-lg-10 col-xl-9">
                    <div class="auth-card">
                        <div class="row g-0">
                            <!-- Hero (desktop) -->
                            <div class="col-md-5 d-none d-md-block">
                                <div class="auth-hero">
                                    <span class="brand-badge">
                                        <i class="bi bi-lightning-charge-fill"></i> Treine+
                                    </span>

                                    <h2 class="mt-3">Crie sua conta em minutos.</h2>
                                    <p class="mt-3">
                                        Comece a registrar treinos e acompanhar evolução com praticidade.
                                    </p>

                                    <div class="mt-4 small-muted">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <i class="bi bi-shield-check"></i> Seus dados protegidos
                                        </div>
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <i class="bi bi-phone"></i> Perfeito no celular
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-graph-up"></i> Evolução visível
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Form -->
                            <div class="col-12 col-md-7">
                                <div class="auth-form">
                                    <div class="brand-badge d-md-none">
                                        <i class="bi bi-lightning-charge-fill"></i> Treine+
                                    </div>

                                    <h3 class="mt-3 mb-1 fw-bold">Criar conta</h3>
                                    <div class="small-muted mb-3">Preencha os dados para se cadastrar.</div>

                                    <form id="registerForm" method="post" asp-route-returnUrl="@Model.ReturnUrl"
                                          class="needs-validation" novalidate>
                                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert">
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="Input.Email" class="form-label">E-mail</label>
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                                <input asp-for="Input.Email" class="form-control"
                                                       placeholder="voce@exemplo.com" autocomplete="username" required />
                                            </div>
                                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="Input.Password" class="form-label">Senha</label>
                                            <div class="input-group">
                                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                                <input asp-for="Input.Password" id="regPassword" class="form-control"
                                                       placeholder="Mín. 6 caracteres" autocomplete="new-password"
                                                       required />
                                                <button class="btn btn-outline-secondary" type="button"
                                                        id="toggleRegPassword" style="border-radius:12px;">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            </div>
                                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                                        </div>

                                        <div class="mb-2">
                                            <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar
                                                senha</label>
                                                <div class="input-group">
                                                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                                    <input asp-for="Input.ConfirmPassword" id="regConfirm"
                                                           class="form-control" placeholder="Repita a senha"
                                                           autocomplete="new-password" required />
                                                    <button class="btn btn-outline-secondary" type="button"
                                                            id="toggleRegConfirm" style="border-radius:12px;">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                </div>
                                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                                                <div id="matchHelp" class="small mt-2 small-muted"></div>
                                            </div>

                                            <button id="registerSubmit" type="submit" class="btn btn-brand w-100 mt-3">
                                                Criar conta <i class="bi bi-arrow-right ms-1"></i>
                                            </button>

                                            <div class="mt-3">
                                                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                                                    ← Voltar
                                                </a>
                                            </div>

                                            <div class="text-center mt-3 small-muted">
                                                Já tem conta?
                                                <a class="link-soft fw-semibold" asp-page="./Login"
                                                   asp-route-returnUrl="@Model.ReturnUrl">Entrar</a>
                                            </div>
                                        </form>

                                    </div>
                                </div>
                            </div><!-- row -->
                        </div><!-- card -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />

        <script>
                // Bootstrap validation + match password
                (() => {
                    'use strict'
                    const forms = document.querySelectorAll('.needs-validation')
                    Array.from(forms).forEach(form => {
                        form.addEventListener('submit', event => {
                            const p = document.getElementById('regPassword');
                            const c = document.getElementById('regConfirm');

                            if (p && c && p.value !== c.value) {
                                c.setCustomValidity('Senha não confere');
                            } else if (c) {
                                c.setCustomValidity('');
                            }

                            if (!form.checkValidity()) {
                                event.preventDefault()
                                event.stopPropagation()
                            }
                            form.classList.add('was-validated')
                        }, false)
                    })
                })()

                // Show/hide password
                const regPwd = document.getElementById('regPassword');
                const regConf = document.getElementById('regConfirm');
                const btnPwd = document.getElementById('toggleRegPassword');
                const btnConf = document.getElementById('toggleRegConfirm');
                const matchHelp = document.getElementById('matchHelp');

                if (regPwd && btnPwd) {
                    btnPwd.addEventListener('click', () => {
                        const isPass = regPwd.type === 'password';
                        regPwd.type = isPass ? 'text' : 'password';
                        btnPwd.innerHTML = isPass ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
                    });
                }

                if (regConf && btnConf) {
                    btnConf.addEventListener('click', () => {
                        const isPass = regConf.type === 'password';
                        regConf.type = isPass ? 'text' : 'password';
                        btnConf.innerHTML = isPass ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
                    });
                }

                function checkMatch() {
                    if (!matchHelp || !regPwd || !regConf) return;
                    if (!regPwd.value && !regConf.value) { matchHelp.textContent = ''; return; }
                    matchHelp.textContent = (regPwd.value === regConf.value)
                        ? '✅ As senhas conferem.'
                        : '⚠️ As senhas não conferem.';
                }

                if (regPwd) regPwd.addEventListener('input', checkMatch);
                if (regConf) regConf.addEventListener('input', checkMatch);
        </script>
    }